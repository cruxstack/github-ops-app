# every value may instead be an ssm parameter arn, such as
# arn:aws:ssm:us-east-1:123456789012:parameter/github-ops-app/slack-token

# logging: debug, info, warn, or error (default: info)
# APP_LOG_LEVEL=info

# server (cmd/server only)
# APP_LISTEN_ADDR=:8080
# routes are served under this path, such as an api gateway stage (optional)
# APP_BASE_PATH=/prod
# external url of the service, including APP_BASE_PATH; used by the installer
# APP_PUBLIC_URL=https://github-ops.example.com

# admin token for /server/* and /scheduled/*, at least 16 characters; the
# admin endpoints are disabled when it is unset
# APP_ADMIN_TOKEN=change-me-to-a-long-random-string

# github app (required)
APP_GITHUB_ORG=acme
APP_GITHUB_APP_ID=123456
APP_GITHUB_APP_PRIVATE_KEY_PATH=./.local/github-private-key.pem
# or the key itself, with literal newlines or \n escapes
# APP_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
APP_GITHUB_WEBHOOK_SECRET=change-me
# looked up from the organization when unset
# APP_GITHUB_INSTALLATION_ID=987654
# api url for github enterprise server
# APP_GITHUB_BASE_URL=https://github.example.com/api/v3

# github app installer (optional): serves /setup to create the app from a
# manifest and saves its credentials; disable it once the app is created
# GITHUB_APP_INSTALLER_ENABLED=true
# STORAGE_MODE=envfile          # envfile or aws-ssm
# STORAGE_DIR=./.env            # env file the envfile mode writes
# AWS_SSM_PARAMETER_PREFIX=/github-ops-app/
# AWS_SSM_KMS_KEY_ID=alias/github-ops-app

# pr compliance (optional)
APP_PR_COMPLIANCE_ENABLED=true
# branch names or glob patterns
APP_PR_MONITORED_BRANCHES=main,master,release/*

# okta group sync (optional; setting any okta value requires all of them)
APP_OKTA_DOMAIN=acme.okta.com
APP_OKTA_CLIENT_ID=0oaxxxxxxxxxxxxxxxxxxxxx
APP_OKTA_PRIVATE_KEY_PATH=./.local/okta-private-key.pem
# APP_OKTA_PRIVATE_KEY_ID=kid-from-okta
# APP_OKTA_SCOPES=okta.groups.read,okta.users.read
APP_OKTA_GITHUB_USER_FIELD=githubUsername
APP_OKTA_SYNC_RULES=[{"name":"sync-eng","okta_group_pattern":"^github-eng-.*","strip_prefix":"github-eng-","github_team_prefix":"eng-","create_team_if_missing":true}]
# refuse to remove more than this share of a team's members (default: 0.5)
# APP_OKTA_SYNC_SAFETY_THRESHOLD=0.5
# APP_OKTA_ORPHANED_USER_NOTIFICATIONS=true

# stale security alerts (optional)
# APP_SECURITY_ALERTS_ENABLED=true
# APP_SECURITY_ALERTS_MIN_AGE_DAYS=30
# APP_SECURITY_ALERTS_MIN_SEVERITY=high

# slack (optional; the token and channel are required together)
APP_SLACK_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_SLACK_CHANNEL=C01234ABCDE
# per notification type; each falls back to APP_SLACK_CHANNEL
# APP_SLACK_CHANNEL_PR_BYPASS=C01234ABCDE
# APP_SLACK_CHANNEL_OKTA_SYNC=C01234ABCDE
# APP_SLACK_CHANNEL_ORPHANED_USERS=C01234ABCDE
# APP_SLACK_CHANNEL_SECURITY_ALERTS=C01234ABCDE
# footer for pr bypass notifications, in slack mrkdwn
# APP_SLACK_FOOTER_NOTE_PR_BYPASS=_Please review the <https://example.com/policy|security policy>._
