{
  "name": "github-ops-app",
  "url": "https://github.com/cruxstack/github-ops-app",
  "hook_attributes": {
    "url": "https://your-api-gateway-url.execute-api.region.amazonaws.com/webhooks",
    "active": true
  },
  "redirect_url": "https://github.com/cruxstack/github-ops-app",
  "description": "Syncs Okta groups to GitHub teams, reports PRs merged without meeting branch requirements, and reports stale security alerts",
  "public": false,
  "default_permissions": {
    "administration": "read",
    "checks": "read",
    "members": "write",
    "metadata": "read",
    "pull_requests": "read",
    "secret_scanning_alerts": "read",
    "security_events": "read",
    "statuses": "read",
    "vulnerability_alerts": "read"
  },
  "default_events": [
    "pull_request",
    "team",
    "membership"
  ]
}
